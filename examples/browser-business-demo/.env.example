# Copy this file outside the repository or to a local ignored path, then fill real values.
# Use with:
#   BROWSER_BUSINESS_ENV_FILE=/path/to/browser-business-demo.env pnpm test:browser-business-demo

BROWSER_BUSINESS_DEMO_URL=https://your-business-system.example/path
BROWSER_BUSINESS_SKILL_PACKS_DIR=/absolute/path/to/your/browser-skill-packs
BROWSER_BUSINESS_DEMO_INPUTS={"field":"value"}
BROWSER_BUSINESS_DEMO_INTENT=your_workflow_intent
BROWSER_BUSINESS_EXPECT_SKILL_PAGE=your_page_id
BROWSER_BUSINESS_EXPECT_RISK_ACTION=your_risk_gate_step_id
BROWSER_BUSINESS_ASSERTIONS=[{"name":"未提交","code":"document.body.dataset.submitted ?? null","equals":null}]
BROWSER_BUSINESS_EVIDENCE_FILE=.omx/artifacts/browser-business-demo.json

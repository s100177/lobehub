# Copy this file to .env before deployment.
#
# Required app URL. Use the browser-accessible URL of your deployment.
APP_URL=http://localhost:3211
LOBE_PORT=3211

# Required random secrets. Generate your own values; do not reuse examples.
# Example:
#   openssl rand -base64 32
KEY_VAULTS_SECRET=replace-with-random-base64
AUTH_SECRET=replace-with-random-base64

# Database.
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=replace-with-random-password

# RustFS / S3-compatible object storage.
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=replace-with-random-password
RUSTFS_LOBE_BUCKET=lobe
S3_ENDPOINT=http://localhost:9000

# Device Gateway.
DEVICE_GATEWAY_PORT=8787
DEVICE_GATEWAY_SERVICE_TOKEN=replace-with-random-token

# Browser service for the live browser tool.
BROWSER_SERVICE_TOKEN=replace-with-random-token
# Origin(s) of Bridge-enabled business apps embedded in the Browser panel.
BROWSER_IFRAME_ALLOWED_ORIGINS=http://business-app.example.com
# Comma-separated hosts that Remote Playwright may access inside private networks.
BROWSER_ALLOW_PRIVATE_HOSTS=
BROWSER_MAX_SESSIONS=20
BROWSER_SESSION_IDLE_MS=300000

# JWKS used by Device Gateway to verify device auth JWTs.
# This must match the server-side JWKS_KEY public key.
# See README.zh-CN.md for generation notes.
JWKS_KEY=replace-with-jwks-private-json
DEVICE_GATEWAY_JWKS_PUBLIC_KEY=replace-with-jwks-public-json
